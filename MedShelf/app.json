{
  "expo": {
    "name": "MedShelf",
    "slug": "medshelf",
    "scheme": "medshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medshelf.offline"
    },
    "android": {
      "package": "com.medshelf.offline"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      "expo-asset"
    ]
  }
}
